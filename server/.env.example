# Copy to server/.env (local) and fill in. Never commit the real .env file.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database. Pick ONE:
#   Cloud (MongoDB Atlas, recommended, works for deployment too):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fixtrail?retryWrites=true&w=majority
#   Local (docker compose up -d):
# MONGODB_URI=mongodb://localhost:27017/fixtrail

# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Email-only login (no password). Local testing: leave as true.
DEMO_LOGIN=true
# Only for a deployed test build. Makes the server accept DEMO_LOGIN in production.
# Leave false for anything real.
DEMO_LOGIN_ACKNOWLEDGED=false
